# Copy to .env and fill in. Never commit .env. Values below are names only, no secrets.

# --- General ---
ENVIRONMENT=production
SITE_ADDRESS=
PUBLIC_BASE_URL=
COOKIE_SECURE=true
LOG_LEVEL=INFO
POSTGRES_PASSWORD=
# Comma-separated urlsafe-base64 32-byte keys. First encrypts, all decrypt (rotation).
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=

# --- hh.ru (optional: leave empty to run without API access) ---
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_APP_ACCESS_TOKEN=
# Required by hh.ru for every request, e.g. "AppName/1.0 (contact@example.com)"
HH_USER_AGENT=

# --- AI (optional: local works without any external service) ---
# local | openai_compatible | anthropic
AI_PROVIDER=local
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PRICE_INPUT_PER_1K=
AI_PRICE_OUTPUT_PER_1K=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Demo ---
DEMO_MODE=false
