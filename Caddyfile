{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /api/*
	handle @api {
		request_body {
			max_size 8MB
		}
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
